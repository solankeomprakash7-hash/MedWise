rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Learner record: readable by its owner; plan fields are written only by the payment functions (Admin SDK).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['plan', 'planUntil']);
      // ECG progress: the owner reads and writes freely.
      match /ecg/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Landing-page email list: anyone may add their email; nobody may read or change entries.
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() < 200;
      allow read, update, delete: if false;
    }
    // Module feedback: anyone may add one rating (1-5) with an optional short comment; nobody may read or change it from the app.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['module', 'rating', 'comment', 'plan', 'uid', 'score', 'of', 'createdAt'])
        && request.resource.data.module is string && request.resource.data.module.size() < 40
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
        && (request.resource.data.uid == null || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    // Payment records: server only.
    match /payments/{id} { allow read, write: if false; }
  }
}
