# GEMINI_API_KEY: used only by the Netlify function netlify/functions/sepsis-analyze.ts (server side).
# Set it in Netlify > Site settings > Environment variables. It is never bundled into the browser code.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# On Netlify, this would be your .netlify.app URL.
APP_URL=""
